{
  "executor": {
    "name": "TUR55_Executor",
    "version": "0.1.0",
    "device_id": "esp32_001"
  },
  "event": {
    "blockchain": "ethereum",
    "rpc_url": "https://sepolia.infura.io/v3/YOUR_KEY",
    "contract_address": "0x0000000000000000000000000000000000000000",
    "event_name": "ExecutorTriggered",
    "poll_interval_sec": 5,
    "use_mock": true,
    "mock": {
      "max_events": 3,
      "interval_sec": 0.0,
      "seed": 0,
      "custom_data": {
        "duration_sec": 120
      }
    }
  },
  "delivery": {
    "transport": "file",
    "mqtt": {
      "broker": "broker.hivemq.com",
      "port": 1883,
      "topic": "tur55/device/esp32_001",
      "qos": 1,
      "retain": false
    },
    "file": {
      "output_dir": "outputfiles/",
      "filename": "program.enc"
    }
  },
  "keys": {
    "esp32_public_key": "keys/esp32_public_key.pem",
    "executor_private_key": "keys/executor_private_key.pem"
  },
  "inputfiles": {
    "template": "inputfiles/example_led.json"
  },
  "logging": {
    "level": "INFO",
    "file": "logs/executor.log"
  }
}
